NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GUESTBOOK_FINGERPRINT_SECRET=
GUESTBOOK_ADMIN_EMAIL=

# Public browser variables:
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_TURNSTILE_SITE_KEY
#
# Server-only variables:
# SUPABASE_SERVICE_ROLE_KEY, TURNSTILE_SECRET_KEY, GUESTBOOK_FINGERPRINT_SECRET,
# GUESTBOOK_ADMIN_EMAIL
#
# Public approved-entry reading requires:
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#
# Guestbook submissions require:
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_TURNSTILE_SITE_KEY,
# TURNSTILE_SECRET_KEY, GUESTBOOK_FINGERPRINT_SECRET
#
# Private moderation requires:
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# GUESTBOOK_ADMIN_EMAIL
#
# Local-only Turnstile bypass:
# Set NEXT_PUBLIC_TURNSTILE_SITE_KEY=dev-bypass and TURNSTILE_SECRET_KEY=dev-bypass
# outside production only.
