NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GUESTBOOK_FINGERPRINT_SECRET=
GUESTBOOK_ADMIN_EMAIL=

# Public browser variables:
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_TURNSTILE_SITE_KEY
#
# Server-only variables:
# SUPABASE_SERVICE_ROLE_KEY, TURNSTILE_SECRET_KEY, GUESTBOOK_FINGERPRINT_SECRET,
# GUESTBOOK_ADMIN_EMAIL
#
# Public approved-entry reading requires:
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#
# Guestbook submissions require:
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_TURNSTILE_SITE_KEY,
# TURNSTILE_SECRET_KEY, GUESTBOOK_FINGERPRINT_SECRET
#
# Private moderation requires:
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# GUESTBOOK_ADMIN_EMAIL
#
# Local-only Turnstile bypass:
# Set NEXT_PUBLIC_TURNSTILE_SITE_KEY=dev-bypass and TURNSTILE_SECRET_KEY=dev-bypass
# outside production only.

# BOCH PUBLIC intelligence (server-only — never NEXT_PUBLIC_):
# BOCH_PROVIDER=hosted|local|grounded|mock|unavailable
#   Production (VERCEL=1 or BOCH_RUNTIME=production): hosted only.
#     local is refused. Missing AI Gateway credentials → PUBLIC unavailable.
#   Development default: local (workstation Ollama). hosted requires AI_GATEWAY_API_KEY.
# BOCH_RUNTIME=production          # optional local fail-closed test
# BOCH_MODEL=anthropic/claude-sonnet-4.6
# BOCH_MODEL_FAILOVER=google/gemini-3.8-flash
# BOCH_MAX_OUTPUT_TOKENS=400
# BOCH_MODEL_TIMEOUT_MS=45000
# BOCH_OLLAMA_HOST=http://127.0.0.1:11434
# BOCH_OLLAMA_MODEL=qwen2.5:7b
# AI_GATEWAY_API_KEY=              # server-only; or Vercel OIDC
#
# Current-information (time-sensitive world facts):
# BOCH_CURRENT_PROVIDER=auto|brave|off
# BOCH_RETRIEVAL_TIMEOUT_MS=8000
# BRAVE_SEARCH_API_KEY=            # optional; auto uses DuckDuckGo then Wikipedia
#
# Durable visitor sessions:
# BOCH_SESSION_SECRET=             # signs jackos-boch-ctx cookie (or GUESTBOOK_FINGERPRINT_SECRET)
# KV_REST_API_URL=                 # optional Upstash/Vercel KV
# KV_REST_API_TOKEN=
#
# BOCH PUBLIC voice (server-only):
# BOCH_TTS_URL=                    # hosted Aiden sidecar; loopback refused in production
# BOCH_TTS_VOICE=Aiden
# BOCH_TTS_MODEL=openai/tts-1-hd   # public stand-in when sidecar is absent
# BOCH_TTS_OPENAI_VOICE=onyx
# Set BOCH_TTS_URL=0 to skip sidecar even locally (browser speechSynthesis fallback).
